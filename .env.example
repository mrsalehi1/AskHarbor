# Copy this file to server/.env before starting the API from the server directory.
# These values are placeholders. Do not put real passwords, API keys, or tokens here.
# Use * only on your own machine. Production should list the sites allowed to embed the widget.

ASKHARBOR_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com

# Optional. Directory of bot content files, one JSON file per bot.
# Defaults to server/content when unset. See "Bot content" in README.md.
#ASKHARBOR_CONTENT_DIR=/srv/askharbor/content

# Optional. Serve bots from PostgreSQL instead of the content files.
# See "PostgreSQL storage" in README.md.
#ASKHARBOR_CONTENT_SOURCE=database
#ASKHARBOR_DATABASE_URL=postgresql+psycopg://askharbor:askharbor@127.0.0.1:5432/askharbor

# Production: supply your own first admin password (12+ characters). The server
# refuses to start with the documented local one. See "Accounts and login" in README.md.
#ASKHARBOR_ENV=production
#ASKHARBOR_BOOTSTRAP_ADMIN_USERNAME=admin
#ASKHARBOR_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-secret
