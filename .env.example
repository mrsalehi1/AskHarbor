# Example production environment for AskHarbor. Copy the values you need into
# your deployment's secret store; do not commit real passwords, keys or tokens.
# The full list of settings is in server/.env.example and README.md.

ASKHARBOR_ENV=production
ASKHARBOR_DATABASE_URL=postgresql+psycopg://askharbor:REPLACE_ME@db.internal:5432/askharbor
ASKHARBOR_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com
ASKHARBOR_PUBLIC_URL=https://faq.example.com
ASKHARBOR_ADMIN_DIST=/srv/askharbor/widget-dist
ASKHARBOR_SEED_SAMPLE_CONTENT=false

# First start only, then remove: creates the first admin with a temporary
# password of 12+ characters. Completion is recorded in the database.
#ASKHARBOR_BOOTSTRAP_ADMIN_USERNAME=admin
#ASKHARBOR_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_SECRET

# Session cookies must stay Secure in production (the default). Do not set
# ASKHARBOR_COOKIE_SECURE=false here.
