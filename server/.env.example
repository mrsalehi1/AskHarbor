# Allowed origins for browser requests, as a comma separated list of exact
# origins. Spaces around each origin and trailing slashes are trimmed, so
# https://example.com/ matches a browser Origin of https://example.com.
# Paths are not supported. Ports are kept, for example http://localhost:3000.
#
#   ASKHARBOR_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com
#
# Unset and empty behave differently:
#   - If the variable is not set at all, the server defaults to * and allows
#     any origin. That is intended for local development only.
#   - If the variable is set but contains no usable origins (blank, or only
#     spaces, commas, or slashes), the server refuses to start and explains
#     the problem, because an empty list would silently block every browser
#     request.
#
# The value below permits the local demo page.
ASKHARBOR_ALLOWED_ORIGINS=http://127.0.0.1:4173

# Request limit for POST /api/v1/bots/{bot_id}/messages, enforced inside the
# API process per client address. Health and bot configuration requests are
# never limited.
#
# Default: 30 requests per 60 second window. Requests over the limit receive
# HTTP 429 with a Retry-After header and the detail
# "Too many requests. Try again in N seconds." Set the limit to 0 to disable it.
#
# Counters live in process memory only, hold no visitor IDs or profiles, and
# are capped at 10000 clients. Each uvicorn worker keeps its own counters, and
# behind a reverse proxy all visitors share the proxy's address. For more than
# one worker or a proxy, enforce the limit at the proxy and set the limit to 0.
# See "Request limits" in README.md.
#
# Example: 10 requests every 30 seconds.
#ASKHARBOR_MESSAGE_RATE_LIMIT=10
#ASKHARBOR_MESSAGE_RATE_WINDOW_SECONDS=30

# Directory holding the bot content files, one JSON file per bot. The bot ID is
# the config.id inside each file. Every file is validated at startup and on
# each reload (send SIGHUP to the uvicorn process). A blank value is an error;
# remove the variable to use the default server/content directory.
# See "Bot content" in README.md.
#ASKHARBOR_CONTENT_DIR=/srv/askharbor/content

# Where public bots are served from: "files" (default, the content directory
# above) or "database" (PostgreSQL). Database mode needs ASKHARBOR_DATABASE_URL,
# a migrated database (python -m alembic upgrade head) and imported content
# (python -m app.import_content). See "PostgreSQL storage" in README.md.
#ASKHARBOR_CONTENT_SOURCE=database
#ASKHARBOR_DATABASE_URL=postgresql+psycopg://askharbor:askharbor@127.0.0.1:5432/askharbor
