# Copy this file to server/.env. Values here are for local development on your
# own machine; a deployment sets its own through the environment. Never commit
# real passwords. See README.md for every setting.

# --- Database and accounts ---------------------------------------------------
# With a database URL the bots are served from PostgreSQL, the panel at /admin
# works, and accounts are enabled. Without it the API serves the JSON files in
# server/content and accounts are disabled. Run "python -m alembic upgrade head"
# after setting this and after every update.
ASKHARBOR_DATABASE_URL=postgresql+psycopg://askharbor:askharbor@127.0.0.1:5432/askharbor

# First start only: the admin created when bootstrap has never run. Unset means
# the documented local account admin / ChangeMeLocal123! in development. In
# production set a secret of 12+ characters for the first start, then remove it;
# completion is recorded in the database and the server starts without it.
#ASKHARBOR_BOOTSTRAP_ADMIN_USERNAME=admin
#ASKHARBOR_BOOTSTRAP_ADMIN_PASSWORD=

# "development" (default) or "production". Production refuses the development
# password, short passwords and insecure cookies.
#ASKHARBOR_ENV=development

# Load the two fictional sample websites into an empty database at first start.
#ASKHARBOR_SEED_SAMPLE_CONTENT=true

# --- Sessions and cookies ------------------------------------------------------
# The session cookie is Secure by default. For plain http://127.0.0.1 development
# set this to false. Production refuses false.
ASKHARBOR_COOKIE_SECURE=false
#ASKHARBOR_SESSION_HOURS=12

# Failed login attempts allowed per client address and per username within one
# window, counted in the database and shared by every worker.
#ASKHARBOR_LOGIN_RATE_LIMIT=5
#ASKHARBOR_LOGIN_RATE_WINDOW_SECONDS=300

# --- Widget and embedding -------------------------------------------------------
# Origins allowed to load bots that have no origin list of their own in the
# panel. Exact origins, comma separated; trailing slashes and spaces are trimmed.
# Unset means * (any origin, development only). Empty is an error.
ASKHARBOR_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:8000

# Public address of this API as visitors reach it, used in the embed snippet.
# Defaults to the address of the request that asks.
#ASKHARBOR_PUBLIC_URL=https://faq.example.com

# Built widget output served at /admin (panel, editor, askharbor.js).
# Default: ../widget/dist relative to server/.
#ASKHARBOR_ADMIN_DIST=/srv/askharbor/widget-dist

# --- File mode -------------------------------------------------------------------
# Content files, one JSON file per bot, used without a database and as the
# sample data. "auto" (default) picks the database when a URL is set.
#ASKHARBOR_CONTENT_DIR=/srv/askharbor/content
#ASKHARBOR_CONTENT_SOURCE=auto

# --- Request limit on POST /api/v1/bots/{bot_id}/messages ----------------------
# Per client address, in process memory. 0 disables it.
#ASKHARBOR_MESSAGE_RATE_LIMIT=30
#ASKHARBOR_MESSAGE_RATE_WINDOW_SECONDS=60
