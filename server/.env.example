# Allowed origins for browser requests, as a comma separated list of exact
# origins. Spaces around each origin and trailing slashes are trimmed, so
# https://example.com/ matches a browser Origin of https://example.com.
# Paths are not supported. Ports are kept, for example http://localhost:3000.
#
#   ASKHARBOR_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com
#
# Unset and empty behave differently:
#   - If the variable is not set at all, the server defaults to * and allows
#     any origin. That is intended for local development only.
#   - If the variable is set but contains no usable origins (blank, or only
#     spaces, commas, or slashes), the server refuses to start and explains
#     the problem, because an empty list would silently block every browser
#     request.
#
# The value below permits the local demo page.
ASKHARBOR_ALLOWED_ORIGINS=http://127.0.0.1:4173

# Request limit for POST /api/v1/bots/{bot_id}/messages, per client address,
# enforced inside the API process (no proxy involved). Health and bot config
# endpoints are never limited. Default: 30 requests per 60 second window.
# Requests over the limit receive HTTP 429 with a Retry-After header giving
# the seconds until the window resets. Set the limit to 0 to disable it, for
# example when a reverse proxy enforces the limit instead (required with more
# than one worker: each worker counts separately). See README, Request limits.
# Counters live in process memory only, hold no visitor IDs or profiles, are
# capped at 10000 clients, and are separate per worker process (see README).
#ASKHARBOR_MESSAGE_RATE_LIMIT=30
#ASKHARBOR_MESSAGE_RATE_WINDOW_SECONDS=60
